{
  "name": "bnb-web",
  "version": "0.1.0",
  "private": true,
  "description": "水球大亂鬥：照爆爆王規則重製的網頁版 2–4 人連線對戰",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "sirv": "^3.0.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
